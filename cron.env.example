# Host-specific settings for the cron scripts (collect.sh, ingest_worker.sh,
# run_*.sh). Copy to cron.env next to the scripts and fill in — cron.env is
# gitignored, so nothing host-specific ends up in this public repository.
#
#   cp cron.env.example cron.env
#
# The scripts source this file, so a plain assignment here takes precedence
# over a variable set in the crontab line. Use the ${VAR:-default} form if you
# want the caller to win instead.

# Where the export archive is written. Must be the file the web server actually
# serves: the export bakes this basename into the page as its update-manifest
# URL (yt.html -> yt.html.meta.json). Defaults to <repo>/yt.html.
EXPORT_OUTPUT=/var/www/html/yt.html

# Sync server base URL, embedded into the exported archive. Leave unset to
# export without sync support.
SYNC_URL=https://sync.example.com/sync/

# Recipient for the digest mails sent by run_6hours.sh / run_12hours.sh /
# run_daily.sh. Required by those scripts — they abort if it is unset.
DIGEST_TO=you@example.com
