<?xml version="1.0" encoding="utf-8"?>
<ncx xmlns="http://www.daisy.org/z3986/2005/ncx/" version="2005-1">
<head>
<meta name="dtb:uid" content="{{ book_id }}"/>
<meta name="dtb:depth" content="2"/>
<meta name="dtb:totalPageCount" content="0"/>
<meta name="dtb:maxPageNumber" content="0"/>
</head>
<docTitle><text>{{ title }}</text></docTitle>
<navMap>
{% set order = namespace(n=1) %}
{% for part in parts %}{% for week in part.weeks %}  <navPoint id="week-{{ loop.index }}-{{ order.n }}" playOrder="{{ order.n }}">
    <navLabel><text>{{ part.title }} &#183; {{ t.book_week }} {{ week.iso_week }}</text></navLabel>
{#- A week points at its first video, so it must carry that video's playOrder:
    the NCX forbids two navPoints with different playOrder for one target. #}
    <content src="{{ week.videos[0].href }}"/>
{% for v in week.videos %}    <navPoint id="nav-{{ v.video_id }}" playOrder="{{ order.n }}">
      <navLabel><text>{{ v.title }}</text></navLabel>
      <content src="{{ v.href }}"/>
    </navPoint>
{% set order.n = order.n + 1 %}
{% endfor %}  </navPoint>
{% endfor %}{% endfor %}</navMap>
</ncx>
