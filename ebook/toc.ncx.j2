<?xml version="1.0" encoding="utf-8"?>
<ncx xmlns="http://www.daisy.org/z3986/2005/ncx/" version="2005-1">
<head>
<meta name="dtb:uid" content="{{ book_id }}"/>
<meta name="dtb:depth" content="1"/>
<meta name="dtb:totalPageCount" content="0"/>
<meta name="dtb:maxPageNumber" content="0"/>
</head>
<docTitle><text>{{ title }}</text></docTitle>
<navMap>
{% set order = namespace(n=1) %}
{% for part in parts %}{% for week in part.weeks %}  <navPoint id="navpoint-{{ order.n }}" playOrder="{{ order.n }}">
    <navLabel><text>{{ part.title }} &#183; {{ t.book_week }} {{ week.iso_week }}</text></navLabel>
    <content src="{{ week.href }}"/>
  </navPoint>
{% set order.n = order.n + 1 %}
{% endfor %}{% endfor %}</navMap>
</ncx>
