# systemd *user* unit for the sync server — runs as the account that owns the
# repository, sync.db and the ingest queue, so no root is involved.
#
#   mkdir -p ~/.config/systemd/user
#   cp yt-sync.service ~/.config/systemd/user/
#   loginctl enable-linger "$USER"     # start at boot, survive logout
#   systemctl --user daemon-reload
#   systemctl --user enable --now yt-sync
#   journalctl --user -u yt-sync -f    # logs
#
# Assumes the checkout at ~/repos/youtube-abo-summarizer and the venv at
# sync-server/.venv (pip install -r requirements.txt there). Adjust both paths
# otherwise. Configuration stays in sync-server/.env, read by the app itself.

[Unit]
Description=YouTube Export Sync Server
After=network-online.target

[Service]
WorkingDirectory=%h/repos/youtube-abo-summarizer/sync-server
ExecStart=%h/repos/youtube-abo-summarizer/sync-server/.venv/bin/gunicorn \
    --workers 2 \
    --bind 127.0.0.1:5000 \
    --access-logfile - \
    sync_server:app
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
