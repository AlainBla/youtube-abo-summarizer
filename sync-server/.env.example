# Required
SECRET_KEY=change-me-to-a-long-random-string
BASE_URL=https://sync.example.com
SMTP_HOST=mail.example.com
SMTP_USER=user@example.com
SMTP_PASS=your-smtp-password

# Optional
PORT=5000
SMTP_PORT=587
SMTP_FROM=user@example.com
# Comma-separated list of allowed emails. Empty = open registration (any email).
ALLOWED_EMAILS=
# Comma-separated emails allowed to trigger on-demand ingestion. Empty = nobody.
INGEST_EMAILS=
# Absolute path to the ingest queue file (required for ingest to work)
INGEST_QUEUE=
# Number of reverse proxies in front (1 behind Apache/Nginx on the same host).
# Without it every client looks like 127.0.0.1 and the per-IP rate limits act
# as one global limit. Leave at 0 when clients connect directly.
TRUSTED_PROXIES=0
