// ── Cookie helpers ─────────────────────────────────────────────────────────────
const COOKIE_READ = 'yt_read';
const COOKIE_BOOKMARK = 'yt_bookmark';
const COOKIE_LANG = 'yt_lang';
const COOKIE_DAYS = 365;

function setCookie(name, value) {
  const d = new Date();
  d.setTime(d.getTime() + (COOKIE_DAYS * 24 * 60 * 60 * 1000));
  document.cookie = name + '=' + encodeURIComponent(value) + ';expires=' + d.toUTCString() + ';path=/';
}

function getCookie(name) {
  const match = document.cookie.match(new RegExp('(^| )' + name + '=([^;]+)'));
  return match ? decodeURIComponent(match[2]) : '';
}

function getSet(name) {
  // Read/bookmark sets live in localStorage (MB-scale limit) rather than a
  // cookie (4096 bytes — silently stops persisting after a few hundred IDs).
  // On first run for a given browser, migrate whatever the old cookie still
  // holds, then retire the cookie so it stops accumulating.
  try {
    const raw = localStorage.getItem(name);
    if (raw !== null) return new Set(JSON.parse(raw).filter(Boolean));
  } catch (e) { /* localStorage unavailable — fall through to migration/empty */ }
  const legacy = getCookie(name);
  const migrated = legacy ? new Set(legacy.split(',').filter(Boolean)) : new Set();
  saveSet(name, migrated);
  document.cookie = name + '=;expires=Thu, 01 Jan 1970 00:00:00 GMT;path=/';
  return migrated;
}

function saveSet(name, set) {
  try {
    localStorage.setItem(name, JSON.stringify(Array.from(set)));
  } catch (e) { /* storage full/unavailable — state won't persist this session */ }
}

function setsEqual(a, b) {
  if (a.size !== b.size) return false;
  for (var v of a) if (!b.has(v)) return false;
  return true;
}

let readSet = getSet(COOKIE_READ);
let bookmarkSet = getSet(COOKIE_BOOKMARK);

function updateCardInPlace(videoId) {
  var article = document.querySelector('[data-video-id="' + videoId + '"]');
  if (!article) return;
  var isRead = readSet.has(videoId);
  var isBookmarked = bookmarkSet.has(videoId);
  article.className = 'video-card' + (isRead ? ' is-read' : '') + (isBookmarked ? ' is-bookmarked' : '');
  var readBtn = article.querySelector('.read-btn');
  if (readBtn) readBtn.className = 'read-btn' + (isRead ? ' is-active' : '');
  var bookmarkBtn = article.querySelector('.bookmark-btn');
  if (bookmarkBtn) bookmarkBtn.className = 'bookmark-btn' + (isBookmarked ? ' is-active' : '');
}

window.toggleRead = function(videoId) {
  if (readSet.has(videoId)) {
    readSet.delete(videoId);
  } else {
    readSet.add(videoId);
  }
  saveSet(COOKIE_READ, readSet);
  {% if sync_url %}syncToggle('read', videoId, readSet.has(videoId) ? 1 : 0);{% endif %}
  var readFilter = document.getElementById('read-filter').value;
  // Before dataReady, applyFiltersAndSort() is a no-op (see its own guard),
  // so falling through to updateCardInPlace() keeps the click giving
  // immediate visual feedback on the pre-rendered card either way.
  if (dataReady && (readFilter === 'read' || readFilter === 'unread')) {
    applyFiltersAndSort(currentPage);
  } else {
    updateCardInPlace(videoId);
  }
};

window.toggleBookmark = function(videoId) {
  if (bookmarkSet.has(videoId)) {
    bookmarkSet.delete(videoId);
  } else {
    bookmarkSet.add(videoId);
  }
  saveSet(COOKIE_BOOKMARK, bookmarkSet);
  {% if sync_url %}syncToggle('bookmark', videoId, bookmarkSet.has(videoId) ? 1 : 0);{% endif %}
  var bookmarkFilter = document.getElementById('bookmark-filter').value;
  // Same reasoning as toggleRead above: fall through to updateCardInPlace()
  // while dataReady is still false so the click always has visible effect.
  if (dataReady && bookmarkFilter === 'bookmarked') {
    applyFiltersAndSort(currentPage);
  } else {
    updateCardInPlace(videoId);
  }
};

