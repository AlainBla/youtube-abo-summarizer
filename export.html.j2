// ── Language detection ─────────────────────────────────────────────────────────
function detectLang() {
  var cookieLang = getCookie(COOKIE_LANG);
  if (cookieLang && I18N[cookieLang]) return cookieLang;

  var browserLangs = navigator.languages ? Array.from(navigator.languages) : [navigator.language || ''];
  for (var i = 0; i < browserLangs.length; i++) {
    var prefix = browserLangs[i].split('-')[0].toLowerCase();
    if (I18N[prefix]) return prefix;
  }

  if (I18N[EMBEDDED_DEFAULT]) return EMBEDDED_DEFAULT;
  return 'de';
}

// ── Update poll ───────────────────────────────────────────────────────────────
// The archive is a static file, so a tab left open keeps showing whatever was
// deployed when it loaded. Polling the manifest sidecar written next to the
// HTML lets the page notice a newer export and offer a reload.
var pendingUpdate = null;    // manifest of the newer export, once one shows up
var dismissedUpdate = null;  // generated_at the visitor waved away

function updatePollable() {
  // A file:// archive has no server to ask, and fetch would fail anyway.
  return /^https?:$/.test(location.protocol);
}

function renderUpdateBanner() {
  var banner = document.getElementById('update-banner');
  if (!banner) return;
  if (!pendingUpdate || pendingUpdate.generated_at === dismissedUpdate) {
    banner.style.display = 'none';
    return;
  }
  var s = I18N[currentLang] || I18N[EMBEDDED_DEFAULT];
  var added = (pendingUpdate.video_count || 0) - MANIFEST.video_count;
  // A filtered export (--hours/--channel) can shrink between runs, and a
  // re-export without new videos keeps the count -- say "updated" then.
  document.getElementById('update-text').textContent =
    added > 0 ? s.updateNew(added) : s.updateGeneric;
  document.getElementById('update-reload').textContent = s.updateReload;
  document.getElementById('update-dismiss').setAttribute('aria-label', s.updateDismiss);
  banner.style.display = '';
}

function dismissUpdate() {
  if (pendingUpdate) dismissedUpdate = pendingUpdate.generated_at;
  renderUpdateBanner();
}

function checkForUpdate() {
  if (!updatePollable()) return Promise.resolve();
  return fetch(MANIFEST_URL, {cache: 'no-store'})
    .then(function (r) { return r.ok ? r.json() : null; })
    .then(function (meta) {
      if (meta && meta.generated_at && meta.generated_at !== MANIFEST.generated_at) {
        pendingUpdate = meta;
      }
      renderUpdateBanner();
    })
    .catch(function () { /* offline, 404, mid-deploy -- just try again later */ });
}

function startUpdatePolling() {
  if (!updatePollable()) return;
  setInterval(function () {
    if (document.visibilityState !== 'hidden') checkForUpdate();
  }, UPDATE_POLL_MS);
  document.addEventListener('visibilitychange', function () {
    if (document.visibilityState === 'visible') checkForUpdate();
  });
}

// ── Apply language ─────────────────────────────────────────────────────────────
function applyLang(lang) {
  currentLang = lang;
  setCookie(COOKIE_LANG, lang);
  var s = I18N[lang];

  document.documentElement.lang = lang;
  document.title = s.pageTitle + ' \u2014 ' + GENERATED_DATE;
  document.getElementById('page-title').textContent = s.pageTitle;
  document.getElementById('page-meta').textContent = s.generated(GENERATED_DATE, TOTAL_VIDEOS);
  document.getElementById('search').placeholder = s.searchPlaceholder;
  document.getElementById('key-hint').textContent = s.keyHint;
  document.getElementById('lang-select').value = lang;

  // channel-filter first option
  document.querySelector('#channel-filter option[value=""]').textContent = s.allChannels;
  // tag-filter first option
  document.querySelector('#tag-filter option[value=""]').textContent = s.allTags;

  // read-filter
  var rfOpts = document.getElementById('read-filter').options;
  rfOpts[0].textContent = s.allVideos;
  rfOpts[1].textContent = s.unreadOnly;
  rfOpts[2].textContent = s.readOnly;

  // bookmark-filter
  var bfOpts = document.getElementById('bookmark-filter').options;
  bfOpts[0].textContent = s.allVideos;
  bfOpts[1].textContent = s.bookmarkedOnly;

  // sort
  var sortOpts = document.getElementById('sort').options;
  sortOpts[0].textContent = s.sortDateDesc;
  sortOpts[1].textContent = s.sortDateAsc;
  sortOpts[2].textContent = s.sortAddedDesc;
  sortOpts[3].textContent = s.sortChannel;
  sortOpts[4].textContent = s.sortTitle;

  // control labels
  document.getElementById('label-date').textContent = s.labelFrom;
  document.getElementById('label-channel').textContent = s.labelChannel;
  document.getElementById('label-tag').textContent = s.labelTag;
  document.getElementById('label-read').textContent = s.labelRead;
  document.getElementById('label-bookmark').textContent = s.labelBookmark;
  document.getElementById('label-sort').textContent = s.labelSort;

  {% if sync_url %}
  // Update sync bar strings
  (function() {
    var emailEl = document.getElementById('sync-email');
    if (emailEl) emailEl.placeholder = s.syncEmailPlaceholder;
    var sendEl = document.getElementById('sync-send-btn');
    if (sendEl) sendEl.textContent = s.syncSendLink;
    var logoutEl = document.getElementById('sync-logout-btn');
    if (logoutEl) logoutEl.textContent = s.syncLogout;
    var ingestInput = document.getElementById('ingest-input');
    if (ingestInput) ingestInput.placeholder = s.ingestPlaceholder;
    var ingestBtn = document.getElementById('ingest-btn');
    if (ingestBtn) ingestBtn.textContent = s.ingestBtn;
  })();
  {% endif %}
  renderUpdateBanner();
  applyFiltersAndSort();
}

// ── Populate channel filter dropdown ──────────────────────────────────────────
function populateChannelFilter() {
  var seen = {};
  var channels = [];
  VIDEOS.forEach(function(v) {
    if (!seen[v.channel_id]) {
      seen[v.channel_id] = true;
      channels.push({id: v.channel_id, title: v.channel_title});
    }
  });
  channels.sort(function(a, b) {
    return a.title.localeCompare(b.title, undefined, {sensitivity: 'base'});
  });
  var sel = document.getElementById('channel-filter');
  channels.forEach(function(c) {
    var opt = document.createElement('option');
    opt.value = c.id;
    opt.textContent = c.title;
    sel.appendChild(opt);
  });
}

// ── Populate tag filter dropdown ───────────────────────────────────────────────
function populateTagFilter() {
  var seen = {};
  var tags = [];
  VIDEOS.forEach(function(v) {
    (v.tags || []).forEach(function(t) {
      if (!seen[t]) { seen[t] = true; tags.push(t); }
    });
  });
  tags.sort(function(a, b) { return a.localeCompare(b, undefined, {sensitivity: 'base'}); });
  var sel = document.getElementById('tag-filter');
  tags.forEach(function(t) {
    var opt = document.createElement('option');
    opt.value = t; opt.textContent = t;
    sel.appendChild(opt);
  });
}

function setTagFilter(tag) {
  var sel = document.getElementById('tag-filter');
  sel.value = (sel.value === tag) ? '' : tag;
  applyFiltersAndSort();
}

function setChannelFilter(channelId) {
  var sel = document.getElementById('channel-filter');
  sel.value = (sel.value === channelId) ? '' : channelId;
  applyFiltersAndSort();
}

function escHtml(s) {
  return String(s == null ? '' : s)
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;');
}

function buildCard(v) {
  var s = I18N[currentLang];

  {% if show_embed %}
  const thumbContent = '<div class="video-embed-facade" onclick="loadEmbed(this, \'' + escHtml(v.video_id) + '\')">'
    + (v.thumbnail_url ? '<img loading="lazy" src="' + escHtml(v.thumbnail_url) + '" alt="' + escHtml(v.title) + '">' : '')
    + '<button class="facade-play" aria-label="Play">&#9654;</button></div>';
  {% else %}
  const thumbContent = v.thumbnail_url
    ? '<img src="' + escHtml(v.thumbnail_url) + '" alt="' + escHtml(v.title) + '">'
    : '<div class="no-thumb">' + s.noThumb + '</div>';
  {% endif %}

  let metaExtras = '';
  if (v.duration) metaExtras += ' &middot; ' + escHtml(v.duration);
  if (v.summary_model) metaExtras += '<span class="model-badge">' + escHtml(v.summary_model) + '</span>';

  const summary = getSummary(v);
  let summaryHtml;
  if (summary) {
    const cut = summary.indexOf('</p>');
    const rest = cut !== -1 ? summary.slice(cut + 4).trim() : '';
    const preview = cut !== -1 ? summary.slice(0, cut + 4) : summary;
    if (rest) {
      summaryHtml = preview
        + '<button class="summary-toggle" onclick="toggleSummary(this)">' + s.showMore + '</button>'
        + '<div class="summary-details" hidden>' + rest + '</div>';
    } else {
      summaryHtml = preview;
    }
  } else if (v.transcript_error === 'ip_blocked') {
    summaryHtml = '<p class="no-transcript ip-blocked">' + s.transcriptIpBlocked + '</p>';
  } else if (v.transcript_error === 'rate_limited') {
    summaryHtml = '<p class="no-transcript rate-limited">' + s.transcriptRateLimited + '</p>';
  } else if (v.transcript_error === 'country_blocked') {
    summaryHtml = '<p class="no-transcript country-blocked">' + s.transcriptCountryBlocked + '</p>';
  } else {
    summaryHtml = '<p class="no-transcript unavailable">' + s.transcriptUnavailable + '</p>';
  }

  var tagsHtml = '';
  if (v.tags && v.tags.length) {
    var activeTag = document.getElementById('tag-filter').value;
    tagsHtml = '<div class="video-tags">'
      + v.tags.map(function(t) {
          var cls = 'tag-chip' + (activeTag === t ? ' active' : '');
          return '<span class="' + cls + '" onclick="setTagFilter(\'' + escHtml(t) + '\')">' + escHtml(t) + '</span>';
        }).join('')
      + '</div>';
  }

  const isRead = readSet.has(v.video_id);
  const isBookmarked = bookmarkSet.has(v.video_id);
  const cardClass = 'video-card' + (isRead ? ' is-read' : '') + (isBookmarked ? ' is-bookmarked' : '');
  const readBtnClass = 'read-btn' + (isRead ? ' is-active' : '');
  const bookmarkBtnClass = 'bookmark-btn' + (isBookmarked ? ' is-active' : '');

  return '<article class="' + cardClass + '" data-video-id="' + escHtml(v.video_id) + '">'
    + '<div class="video-thumb">' + thumbContent + '</div>'
    + '<div class="video-body">'
    + '<div class="video-actions">'
    + '<button class="' + readBtnClass + '" onclick="toggleRead(\'' + escHtml(v.video_id) + '\')">' + s.readBtn + '</button>'
    + '<button class="' + bookmarkBtnClass + '" onclick="toggleBookmark(\'' + escHtml(v.video_id) + '\')">' + s.bookmarkBtn + '</button>'
    + '</div>'
    + '<a class="video-title" href="https://www.youtube.com/watch?v=' + escHtml(v.video_id) + '" target="_blank" rel="noopener">' + escHtml(v.title) + '</a>'
    + '<div class="video-meta"><span class="channel-link" onclick="setChannelFilter(\'' + escHtml(v.channel_id) + '\')">' + escHtml(v.channel_title) + '</span> &middot; ' + escHtml(v.published_at_display) + metaExtras + '</div>'
    + tagsHtml
    + '<div class="video-summary">' + summaryHtml + '</div>'
    + '</div>'
    + '</article>';
}

// Swap a click-to-load facade for the actual YouTube embed (defers iframe cost
// until the user actually wants to watch; only loaded embeds keep playing across
// in-place re-renders).
function loadEmbed(el, id) {
  el.outerHTML = '<iframe class="video-embed" src="https://www.youtube.com/embed/'
    + escHtml(id) + '?autoplay=1" loading="lazy" allow="accelerometer; autoplay; '
    + 'clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>';
}

function getSearchText(v) {
  if (v.search_text !== undefined) return v.search_text;
  const html = getSummary(v) || '';
  const text = html.replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim();
  v.search_text = ((v.title || '') + ' ' + text).toLowerCase();
  return v.search_text;
}

function applyFiltersAndSort(page) {
  // Every filter/sort/search/lang control wires its listener at script-parse
  // time, long before bootstrap() decodes the index -- an interaction during
  // that window would otherwise run this function's VIDEOS.filter(...)
  // against an empty VIDEOS and wipe the pre-rendered first page. Skip the
  // render here; the control's own value is left untouched in the DOM, so
  // bootstrap's own applyLang()/applyFiltersAndSort() call (once dataReady
  // flips true) picks it up and renders exactly what the user chose.
  if (!dataReady) return;

  const q = document.getElementById('search').value.trim().toLowerCase();
  // A text search reads summary text, which lives in the chunks. Matching on a
  // partial set would silently drop hits, so wait for all of them instead.
  if (q && !allChunksReady()) {
    document.getElementById('results-count').textContent = I18N[currentLang].loadingData;
    ensureAllChunks().then(function () { applyFiltersAndSort(page); }).catch(showChunkLoadError);
    return;
  }
  const sort = document.getElementById('sort').value;
  const channelId = document.getElementById('channel-filter').value;
  const tagFilter = document.getElementById('tag-filter').value;
  const readFilter = document.getElementById('read-filter').value;
  const bookmarkFilter = document.getElementById('bookmark-filter').value;
  const dateFrom = document.getElementById('date-filter').value; // "YYYY-MM-DD" or ""

  filtered = VIDEOS.filter(function(v) {
    if (channelId && v.channel_id !== channelId) return false;
    if (tagFilter && !(v.tags || []).includes(tagFilter)) return false;
    if (readFilter === 'read' && !readSet.has(v.video_id)) return false;
    if (readFilter === 'unread' && readSet.has(v.video_id)) return false;
    if (bookmarkFilter === 'bookmarked' && !bookmarkSet.has(v.video_id)) return false;
    if (dateFrom && v.published_at.slice(0, 10) < dateFrom) return false;
    if (q) {
      if (getSearchText(v).indexOf(q) === -1) return false;
    }
    return true;
  });

  focusedIndex = -1;

  filtered.sort(function(a, b) {
    switch (sort) {
      case 'date-asc':
        return a.published_at.localeCompare(b.published_at);
      case 'added-desc': {
        // collect.py stamps one timestamp per run, so a whole run shares the
        // same collected_at -- tie-break on publish date to keep those blocks
        // in a stable, meaningful order. Older exports carry no collected_at.
        var ac = a.collected_at || a.published_at;
        var bc = b.collected_at || b.published_at;
        var d = bc.localeCompare(ac);
        return d !== 0 ? d : b.published_at.localeCompare(a.published_at);
      }
      case 'channel': {
        var c = a.channel_title.localeCompare(b.channel_title, undefined, {sensitivity: 'base'});
        return c !== 0 ? c : b.published_at.localeCompare(a.published_at);
      }
      case 'title':
        return a.title.localeCompare(b.title, undefined, {sensitivity: 'base'});
      default: // date-desc
        return b.published_at.localeCompare(a.published_at);
    }
  });

  renderPage(typeof page === 'number' ? page : 1);
}

// Update the grid in place when the target slice is a subsequence of the cards
// currently rendered (same relative order, only removals). Removing sibling nodes
// does not reparent the survivors, so their <iframe> embeds keep playing. Returns
// false when a full rebuild is required (reorder, new cards, or page change).
function renderPageInPlace(slice) {
  var grid = document.getElementById('grid');
  var cards = Array.prototype.slice.call(grid.querySelectorAll('.video-card'));
  if (!cards.length) return false;

  var domIds = cards.map(function(c) { return c.getAttribute('data-video-id'); });
  var sliceIds = slice.map(function(v) { return v.video_id; });

  // Walk both ordered lists: slice must appear within domIds in the same order.
  var i = 0;
  for (var j = 0; j < domIds.length && i < sliceIds.length; j++) {
    if (domIds[j] === sliceIds[i]) i++;
  }
  if (i !== sliceIds.length) return false;  // reorder or new cards — needs rebuild

  var keep = {};
  sliceIds.forEach(function(id) { keep[id] = true; });
  cards.forEach(function(c) {
    if (!keep[c.getAttribute('data-video-id')]) c.remove();
  });
  // Refresh mutable read/bookmark visuals on the survivors.
  sliceIds.forEach(updateCardInPlace);
  return true;
}

function renderPage(page, skipScroll) {
  var s = I18N[currentLang];
  // Never render a card whose summary chunk is missing — it would look like a
  // video without a transcript. Keep the current DOM and re-render when ready.
  var wantedPage = Math.min(
    Math.max(1, page),
    Math.max(1, Math.ceil(filtered.length / PAGE_SIZE))
  );
  var pendingStart = (wantedPage - 1) * PAGE_SIZE;
  var pending = filtered.slice(pendingStart, pendingStart + PAGE_SIZE);
  if (pending.length && !chunksReady(pending)) {
    document.getElementById('results-count').textContent = s.loadingData;
    ensureChunks(pending).then(function () { renderPage(page, skipScroll); }).catch(showChunkLoadError);
    return;
  }
  var total = filtered.length;
  var pages = Math.max(1, Math.ceil(total / PAGE_SIZE));
  var prevPage = currentPage;
  currentPage = Math.min(Math.max(1, page), pages);

  var start = (currentPage - 1) * PAGE_SIZE;
  var slice = filtered.slice(start, start + PAGE_SIZE);

  // Prefer an in-place update that preserves existing card DOM nodes (and any
  // playing <iframe> embed) over a full innerHTML rebuild, which would tear down
  // and reload every embed. Status toggles (read/bookmark) only ever *remove*
  // visible cards, so when the new slice is a pure subsequence of what is already
  // rendered we just delete the departed nodes and leave the survivors playing.
  if (!slice.length || !renderPageInPlace(slice)) {
    document.getElementById('grid').innerHTML = slice.length
      ? slice.map(buildCard).join('')
      : '<p class="no-videos">' + s.noVideos + '</p>';
  }

  // Restore focused highlight after re-render
  if (focusedIndex >= 0) {
    var localIdx = focusedIndex - (currentPage - 1) * PAGE_SIZE;
    var cards = document.getElementById('grid').querySelectorAll('.video-card');
    if (cards[localIdx]) cards[localIdx].classList.add('focused');
  }

  document.getElementById('results-count').textContent = s.results(total);

  if (!skipScroll && currentPage !== prevPage) {
    var grid = document.getElementById('grid');
    if (grid) grid.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  var pag = document.getElementById('pagination');
  if (pages <= 1) { pag.innerHTML = ''; return; }

  var html = '';
  var prevDisabled = currentPage <= 1 ? ' disabled' : '';
  var nextDisabled = currentPage >= pages ? ' disabled' : '';

  // First / Prev
  html += '<button onclick="renderPage(1)"' + (currentPage <= 1 ? ' disabled' : '') + '>' + s.firstPage + '</button>';
  html += '<button onclick="renderPage(' + (currentPage - 1) + ')"' + prevDisabled + '>' + s.prevPage + '</button>';

  // Numbered page buttons with ellipsis
  // Always show: 1, last, and the window [cur-2 … cur+2]
  var pageNums = [];
  for (var p = 1; p <= pages; p++) {
    if (p === 1 || p === pages || (p >= currentPage - 2 && p <= currentPage + 2)) {
      pageNums.push(p);
    }
  }
  var lastEmitted = 0;
  for (var i = 0; i < pageNums.length; i++) {
    var pn = pageNums[i];
    if (pn - lastEmitted > 1) {
      html += '<span class="page-ellipsis">\u2026</span>';
    }
    var activeClass = pn === currentPage ? ' class="active"' : '';
    html += '<button' + activeClass + ' onclick="renderPage(' + pn + ')">' + pn + '</button>';
    lastEmitted = pn;
  }

  // Next / Last
  html += '<button onclick="renderPage(' + (currentPage + 1) + ')"' + nextDisabled + '>' + s.nextPage + '</button>';
  html += '<button onclick="renderPage(' + pages + ')"' + (currentPage >= pages ? ' disabled' : '') + '>' + s.lastPage + '</button>';

  // Jump-to-page input (only when there are enough pages to be useful)
  if (pages > 6) {
    html += '<span class="page-jump">'
      + '<input type="number" id="page-jump-input" min="1" max="' + pages + '" placeholder="' + escHtml(s.pageJumpPlaceholder) + '"'
      + ' onkeydown="if(event.key===\'Enter\'){var v=parseInt(this.value);if(v>=1&&v<=' + pages + ')renderPage(v);}">'
      + '<button onclick="var v=parseInt(document.getElementById(\'page-jump-input\').value);if(v>=1&&v<=' + pages + ')renderPage(v);">' + escHtml(s.pageJumpBtn) + '</button>'
      + '</span>';
  }

  pag.innerHTML = html;
}

function toggleSummary(btn) {
  var details = btn.nextElementSibling;
  var open = details.hidden === false;
  details.hidden = open;
  btn.textContent = open ? I18N[currentLang].showMore : I18N[currentLang].showLess;
}

function focusCard(idx) {
  if (filtered.length === 0) return;
  idx = Math.max(0, Math.min(filtered.length - 1, idx));
  focusedIndex = idx;

  var targetPage = Math.floor(idx / PAGE_SIZE) + 1;
  if (targetPage !== currentPage) {
    renderPage(targetPage);
  } else {
    var cards = document.getElementById('grid').querySelectorAll('.video-card');
    cards.forEach(function(c) { c.classList.remove('focused'); });
    var localIdx = idx - (currentPage - 1) * PAGE_SIZE;
    if (cards[localIdx]) cards[localIdx].classList.add('focused');
  }

  var localIdx = idx - (currentPage - 1) * PAGE_SIZE;
  var cards = document.getElementById('grid').querySelectorAll('.video-card');
  if (cards[localIdx]) cards[localIdx].scrollIntoView({behavior: 'smooth', block: 'nearest'});
}

document.addEventListener('keydown', function(e) {
  if (e.target.tagName === 'INPUT' || e.target.tagName === 'SELECT' || e.target.tagName === 'TEXTAREA') return;
  if (e.metaKey || e.ctrlKey || e.altKey) return;
  if (e.key === 'j' || e.key === 'ArrowDown') {
    e.preventDefault();
    focusCard(focusedIndex < 0 ? 0 : focusedIndex + 1);
  } else if (e.key === 'k' || e.key === 'ArrowUp') {
    e.preventDefault();
    focusCard(focusedIndex < 0 ? 0 : focusedIndex - 1);
  }
});

document.getElementById('search').addEventListener('input', function() {
  clearTimeout(debounceTimer);
  debounceTimer = setTimeout(applyFiltersAndSort, 200);
});

document.getElementById('channel-filter').addEventListener('change', applyFiltersAndSort);
document.getElementById('tag-filter').addEventListener('change', applyFiltersAndSort);
document.getElementById('read-filter').addEventListener('change', applyFiltersAndSort);
document.getElementById('bookmark-filter').addEventListener('change', applyFiltersAndSort);
document.getElementById('date-filter').addEventListener('change', applyFiltersAndSort);
document.getElementById('sort').addEventListener('change', applyFiltersAndSort);
document.getElementById('lang-select').addEventListener('change', function() {
  applyLang(this.value);
});

// ── Data loading (index first, summary chunks on demand) ──────────────────────
async function gunzipB64(b64) {
  var bin = atob(b64);
  var bytes = new Uint8Array(bin.length);
  for (var i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);
  if (typeof DecompressionStream === 'undefined') {
    throw new Error('DecompressionStream unsupported');
  }
  var stream = new Blob([bytes]).stream().pipeThrough(new DecompressionStream('gzip'));
  return JSON.parse(await new Response(stream).text());
}

function ensureChunk(k) {
  if (CHUNKS[k]) return Promise.resolve(CHUNKS[k]);
  if (!CHUNK_PROMISES[k]) {
    CHUNK_PROMISES[k] = gunzipB64(SUM_B64[k]).then(function (map) {
      CHUNKS[k] = map;
      return map;
    }).catch(function (err) {
      // Clear the cache entry so a later retry (another filter/sort change,
      // or prefetchChunks' idle loop) issues a fresh decode attempt instead
      // of replaying this same rejected promise forever.
      CHUNK_PROMISES[k] = null;
      throw err;
    });
  }
  return CHUNK_PROMISES[k];
}

function chunksReady(list) {
  return list.every(function (v) { return !!CHUNKS[v._c]; });
}

// A chunk that never decodes would otherwise leave "results-count" stuck on
// the loading text forever, with no visible sign anything went wrong. Surface
// it in the same spot instead -- the cache entry is already cleared (see
// ensureChunk's catch), so retrying the interaction (change a filter, search
// again) attempts a fresh decode rather than replaying this failure.
function showChunkLoadError(err) {
  console.error('Failed to load video summary data:', err);
  document.getElementById('results-count').textContent = 'Error loading video data.';
}

function ensureChunks(list) {
  var wanted = {};
  list.forEach(function (v) { wanted[v._c] = true; });
  return Promise.all(Object.keys(wanted).map(function (k) { return ensureChunk(+k); }));
}

function allChunksReady() {
  for (var k = 0; k < SUM_B64.length; k++) if (!CHUNKS[k]) return false;
  return true;
}

function ensureAllChunks() {
  var all = [];
  for (var k = 0; k < SUM_B64.length; k++) all.push(ensureChunk(k));
  return Promise.all(all);
}

// Pull the remaining chunks in while the browser is idle, so a search later on
// usually finds everything already decoded.
function prefetchChunks() {
  var idle = window.requestIdleCallback || function (cb) { return setTimeout(cb, 50); };
  var next = 0;
  function step() {
    while (next < SUM_B64.length && CHUNKS[next]) next++;
    if (next >= SUM_B64.length) return;
    ensureChunk(next).then(function () { idle(step); }).catch(function (err) {
      // Best-effort background prefetch -- one bad chunk should not stall
      // the whole loop. Move on; a page/search that actually needs this
      // chunk will retry the decode on demand via ensureChunk/ensureChunks.
      console.error('Prefetch failed for summary chunk', next, err);
      next++;
      idle(step);
    });
  }
  idle(step);
}

// Summary HTML lives in the chunk that covers this video's index position.
function getSummary(v) {
  var map = CHUNKS[v._c];
  return map ? map[v.video_id] : undefined;
}

async function bootstrap() {
{% if compressed %}
  try {
    VIDEOS = await gunzipB64(INDEX_B64);
    VIDEOS.forEach(function (v, i) { v._c = (i / CHUNK_SIZE) | 0; });
    // SUM_B64 is empty for a zero-video archive -- nothing to decode.
    if (SUM_B64.length) await ensureChunk(0);   // covers the first page
  } catch (e) {
    document.getElementById('grid').innerHTML =
      '<p class="no-videos">This archive needs a modern browser '
      + '(DecompressionStream support). Re-export with --no-compress for older browsers.</p>';
{% if sync_url %}
    // dataReady stays false -- VIDEOS never gets populated on this path, so
    // initSync()'s eventual applyServerState()/applyFiltersAndSort() will
    // merge state but skip rendering, leaving the message above intact. The
    // sync bar still needs to reflect the visitor's real login state though.
    initSync();
{% endif %}
    return;
  }
{% else %}
  VIDEOS = DATA_OBJ.index || [];
  VIDEOS.forEach(function (v) { v._c = 0; });
  CHUNKS[0] = DATA_OBJ.summaries || {};
{% endif %}
  dataReady = true;
  populateChannelFilter();
  populateTagFilter();
  // The pre-rendered cards carry the export's default language. If the visitor
  // resolves to a different one, drop them so applyLang() rebuilds from scratch.
  var lang = detectLang();
  if (lang !== EMBEDDED_DEFAULT) document.getElementById('grid').innerHTML = '';
  applyLang(lang);
{% if sync_url %}
  initSync();
{% endif %}
  prefetchChunks();
}

startUpdatePolling();

{% if sync_url %}
setTimeout(warnIfInsecure, 0);
window.addEventListener('online', function () {
  if (getSyncToken()) { window.__syncBoot = startSyncRequests(); initSync(); }
});
document.addEventListener('visibilitychange', function() {
  if (document.visibilityState === 'visible') pullServerState();
});
window.addEventListener('focus', pullServerState);
setInterval(pullServerState, 5 * 60 * 1000);
{% endif %}
</script>

<script>
{% if compressed %}const INDEX_B64 = "{{ index_b64 }}";
const SUM_B64 = [{% for c in chunks_b64 %}"{{ c }}"{% if not loop.last %},{% endif %}{% endfor %}];
{% else %}const DATA_OBJ = {{ data_obj }};
const SUM_B64 = [];{% endif %}
// Kick off the boot only once the blobs exist — bootstrap() reads them, and a
// requestAnimationFrame scheduled from the UI script could fire while the
// parser is still working through this script (temporal dead zone).
requestAnimationFrame(function () { bootstrap(); });
</script>

</body>
</html>
